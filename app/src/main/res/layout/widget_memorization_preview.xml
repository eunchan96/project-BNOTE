<?xml version="1.0" encoding="utf-8"?><!-- 위젯 추가 화면(위젯 목록)에서 보여줄 "암송 구절" 미리보기(안드로이드 12 이상). 실제 위젯
     레이아웃(widget_memorization)을 바꾸면 여기도 맞춰준다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_widget_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_book_open"
                android:tint="@color/widget_light_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="요한복음 3장 16절"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_light_accent" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                app:tint="@color/widget_light_accent"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_widget_pill_light" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:fontFamily="serif"
            android:text="하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니 이는 그를 믿는 자마다 멸망하지 않고 영생을 얻게 하려 하심이라"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/widget_light_text_primary" />

    </LinearLayout>

</FrameLayout>