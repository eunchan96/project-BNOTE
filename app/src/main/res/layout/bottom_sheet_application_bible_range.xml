<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:background="@color/surface_elevated">

    <include layout="@layout/include_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/text_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="책 선택"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_delete_ref"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/icon_action_tint"
            android:contentDescription="삭제"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/row_multi_checkboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:alignItems="center">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox_multi_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여러 구절 선택하기"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox_cross_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="다음 장까지 선택하기"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox_chapter_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="장만 선택"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/text_selected_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brown_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            tools:text="창세기 1장 1절~" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/container_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_light" />

    <ScrollView
        android:id="@+id/scroll_book_grid"
        android:layout_width="match_parent"
        android:layout_height="420dp">

        <LinearLayout
            android:id="@+id/container_book_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_picker"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:visibility="gone"
        android:padding="4dp" />

</LinearLayout>