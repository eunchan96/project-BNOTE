<?xml version="1.0" encoding="utf-8"?><!-- 선택 창(OptionDialog)의 항목 하나. 문의하기 창(dialog_contact)과 같은 모양으로,
     밝은 박스(bg_book_button) 안에 제목 · (있으면) 한 줄 설명 · 오른쪽 › 화살표를 둔다.
     지금 고른 항목이면 화살표 대신 체크 표시가 나오고 제목이 갈색 굵은 글씨가 된다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/bg_book_button"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_option_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/text_option_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/icon_option_end"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_hint"
        android:importantForAccessibility="no" />
</LinearLayout>