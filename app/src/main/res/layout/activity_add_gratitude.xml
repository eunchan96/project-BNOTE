<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_gratitude_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brown_primary"
        android:paddingStart="4dp">

        <ImageView
            android:id="@+id/btn_top_bar_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/white"
            android:contentDescription="뒤로가기"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/text_top_bar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/btn_pick_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="날짜 선택"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <com.chan.bnote.ui.common.NoAutoScrollScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/container_gratitude_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 항목 추가 · 순서 변경: 글자 크기만큼의 작은 버튼 두 개를 가운데에 나란히. 순서 변경 중엔 오른쪽이 "완료"가 되고 왼쪽은 잠긴다. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="start">

                <TextView
                    android:id="@+id/btn_add_gratitude_entry"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="88dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:text="항목 추가"
                    android:textSize="13sp"
                    android:textColor="@color/brown_text"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_reorder_gratitude"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="88dp"
                    android:layout_marginStart="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:text="순서 변경"
                    android:textSize="13sp"
                    android:textColor="@color/brown_text"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_save_gratitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="14dp"
                android:text="저장하기"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@drawable/bg_save_button"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </com.chan.bnote.ui.common.NoAutoScrollScrollView>

    <!-- 키보드가 올라와 있을 때만 키보드 바로 위에 보이는 편집 바(실행 취소 · 다시 실행 · 서식) -->
    <include layout="@layout/include_keyboard_bar" />

</LinearLayout>