<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- 상단바. 평소(다 들어갈 때)엔 오른쪽에 스페이서(view_top_bar_spacer)가 남는 공간을 채워서
         지금까지와 똑같이 오른쪽 끝에 버튼들이 붙어 보인다. 책 이름이 길거나(예: "데살로니가전서")
         켜진 아이콘이 많아서 화면 폭을 넘어갈 때만, MainActivity가 그 스페이서 너비를 0으로 줄여서
         버튼들이 다 같이 붙은 채로 가로 스크롤되게 한다(고정되는 버튼 없음). 스페이서 너비 계산은
         레이아웃이 끝난 뒤(onTopBarConfigChanged 이후) MainActivity에서 코드로 처리한다. -->
    <HorizontalScrollView
        android:id="@+id/top_bar_scroll"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/brown_primary"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btn_translation"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_book"
                android:contentDescription="대역본 선택"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/text_current_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:text="창세기 1장"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/icon_sermon_indicator"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_sermon_note"
                android:visibility="gone"
                android:contentDescription="이 장의 설교 보기"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/icon_reading_plan_check"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:contentDescription="성경읽기표 완료 체크"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <View
                android:id="@+id/view_top_bar_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/btn_auto_scroll"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                android:contentDescription="자동 스크롤"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                android:contentDescription="검색"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_bookmarks"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="북마크"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <!-- 알림(공지사항) — 마이페이지 탭에서만 보인다. 안 읽은 알림이 있으면 오른쪽 위에 빨간 점. -->
            <FrameLayout
                android:id="@+id/btn_notice_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_notice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="알림"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/dot_notice_top_bar"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_notice_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="메뉴"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar_scroll"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단바 배경 + 구분선 -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/surface_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_light" />
    </LinearLayout>

    <!-- 하단바 콘텐츠: 좌측 이전/다음 장 + 우측 아이콘 3개.
         투명 배경을 꼭 둬야 한다: 아이콘들의 눌림 효과는 "배경이 있는 가장 가까운 부모"의 배경 자리에 그려지는데,
         이 줄에 배경이 없으면 루트 ConstraintLayout까지 올라가서 그 배경(맨 아래 층)에 그려지고, 그 위를 하단바 배경(bottom_nav)이 덮어버려서 눌림 효과가 안 보였다.
         투명 배경을 주면 이 줄이 효과를 받아서 하단바 배경 위에 그려지고, 색이 없으니 아래 구분선도 그대로 보인다. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_prev_chapter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="이전 장"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_next_chapter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="다음 장"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/nav_bible"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_book_open"
            android:contentDescription="성경"
            app:tint="@color/bottom_nav_selected"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/nav_sermon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="설교"
            app:tint="@color/bottom_nav_unselected"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- 마이페이지 탭 아이콘 + 안 읽은 알림 빨간 점. 점은 아이콘의 선택 색(tint)과 상관없이 항상 빨간색. -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/nav_mypage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_person"
                android:contentDescription="마이페이지"
                app:tint="@color/bottom_nav_unselected"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/dot_notice_nav_mypage"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_notice_dot"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>