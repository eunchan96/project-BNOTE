<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container_selection_toolbar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="24dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_selection_toolbar"
    android:elevation="8dp"
    android:visibility="gone"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/btn_cancel_selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="✕"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:background="#555555" />

    <TextView
        android:id="@+id/btn_toolbar_bookmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="북마크"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btn_toolbar_scrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="스크랩"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btn_toolbar_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="복사"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>