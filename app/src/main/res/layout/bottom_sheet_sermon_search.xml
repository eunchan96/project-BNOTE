<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_drag_handle" />

    <EditText
        android:id="@+id/edit_sermon_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:hint="제목, 메모로 검색"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:background="@drawable/bg_book_button" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_light" />

    <TextView
        android:id="@+id/text_sermon_search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="검색어를 입력해주세요"
        android:textColor="#9E9E9E" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_sermon_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>