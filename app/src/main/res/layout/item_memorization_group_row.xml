<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:gravity="center"
    android:minHeight="88dp"
    android:padding="12dp"
    android:background="@drawable/bg_book_button"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/text_group_row_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/text_group_row_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/text_hint" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_edit_group"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/icon_action_tint"
            android:contentDescription="수정"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btn_delete_group"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/icon_action_tint"
            android:contentDescription="삭제"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>