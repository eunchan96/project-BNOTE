<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="설교자"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_preacher_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름순 ▾"
                android:textSize="13sp"
                android:textColor="@color/brown_primary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_preachers"
            android:layout_width="match_parent"
            android:layout_height="160dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_selected_preacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_sermon_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="날짜순 ▾"
                android:textSize="13sp"
                android:textColor="@color/brown_primary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_empty_preacher_sermons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="설교자를 선택해주세요"
            android:textColor="#9E9E9E" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_preacher_sermons"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/fab_add_sermon_by_preacher"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="+"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_fab_brown"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>