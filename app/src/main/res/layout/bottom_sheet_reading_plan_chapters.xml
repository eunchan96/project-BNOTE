<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:background="@color/surface_elevated">

    <include layout="@layout/include_drag_handle" />

    <TextView
        android:id="@+id/text_reading_plan_chapter_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="탭하면 읽음 체크, 길게 누르면 그 장으로 이동해요"
        android:textSize="12sp"
        android:textColor="@color/text_hint" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_light" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_reading_plan_chapters"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:padding="4dp" />
</LinearLayout>