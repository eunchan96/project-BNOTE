<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_verse_book_part"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="0dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brown_light"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_verse_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="0dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brown_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/text_verse_number"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.chan.bnote.ui.common.SelectionAwareTextView
                android:id="@+id/text_verse_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/text_verse_content_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textColor="@color/brown_light"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 아주 드물게 절이 소제목으로 둘로 쪼개지는 경우(예: 창 35:22)를 위한 뷰들. 평소엔 gone 상태.
         text_verse_title(맨 위 소제목)과 똑같이 절 번호 칸 offset 없이 왼쪽에 붙게 별도 줄로 뺐다. -->
    <TextView
        android:id="@+id/text_verse_mid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/brown_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- 절 번호 칸 폭에 맞춰 어댑터에서 너비를 맞춰준다(숫자 없이 빈 칸으로 들여쓰기만 맞춤). -->
        <View
            android:id="@+id/spacer_verse_number2"
            android:layout_width="26dp"
            android:layout_height="1dp"
            android:layout_marginEnd="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.chan.bnote.ui.common.SelectionAwareTextView
                android:id="@+id/text_verse_content2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/text_verse_content_secondary2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textColor="@color/brown_light"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>