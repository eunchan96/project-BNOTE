<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/memorization_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brown_primary"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/white"
            android:contentDescription="뒤로가기"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="암송 연습"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/text_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/white"
            tools:text="3 / 12" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 저장된 암송 구절이 없을 때 -->
        <TextView
            android:id="@+id/text_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp"
            android:gravity="center"
            android:text="암송 연습을 하려면 먼저 암송 구절을 등록해주세요."
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:visibility="gone" />

        <!-- 카드 / 완료 화면 공통 컨테이너 -->
        <LinearLayout
            android:id="@+id/container_practice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/text_verse_ref"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/brown_primary"
                tools:text="창세기 1장 1절" />

            <LinearLayout
                android:id="@+id/container_verse_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="24dp"
                android:minHeight="160dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/text_verse_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="17sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    tools:text="태초에 하나님이 천지를 창조하시니라" />

                <TextView
                    android:id="@+id/btn_reveal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="탭해서 정답 보기"
                    android:textSize="15sp"
                    android:textColor="@color/text_hint"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:text="태초에 하나님이" />

            <TextView
                android:id="@+id/btn_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="12dp"
                android:text="힌트 보기"
                android:textSize="14sp"
                android:textColor="@color/brown_primary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <LinearLayout
                android:id="@+id/container_answer_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_review_again"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:padding="14dp"
                    android:gravity="center"
                    android:text="다시 볼래요"
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_memorized"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:padding="14dp"
                    android:gravity="center"
                    android:text="외웠어요"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_save_button"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 세션 완료 요약 -->
            <LinearLayout
                android:id="@+id/container_complete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_complete_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    tools:text="오늘 12개 구절을 복습했어요!\n외운 구절 8개" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_restart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:padding="14dp"
                        android:gravity="center"
                        android:text="다시 연습하기"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_save_button"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_review_missed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:padding="14dp"
                        android:gravity="center"
                        android:text="틀린 것 다시 보기"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_save_button"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_quit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:padding="14dp"
                        android:gravity="center"
                        android:text="그만두기"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_book_button"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</LinearLayout>