<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <include layout="@layout/include_activity_top_bar" />

    <!-- 미리보기. 스크롤 영역 밖에 고정해서, 아래 설정을 만지는 동안에도 계속 보이게 한다. 크기는 코드에서
         실제 위젯 크기에 맞춰 정한다(WidgetConfigActivity 참고). -->
    <FrameLayout
        android:id="@+id/container_preview_backdrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/bg_widget_preview_backdrop">

        <FrameLayout
            android:id="@+id/container_widget_preview"
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위젯 테마"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brown_primary" />

            <RadioGroup
                android:id="@+id/radio_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="라이트"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/radio_theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="다크"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="앱의 다크모드 설정과는 별개로, 이 위젯에만 적용돼요."
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <!-- 배경 투명도: 10% 단위로 움직인다. 글자는 그대로고 배경 그림에만 적용된다. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="배경 투명도"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown_primary" />

                <TextView
                    android:id="@+id/text_transparency_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_transparency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="10" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="불투명"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="투명"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="높일수록 배경이 투명해져요. 글자 색은 위젯 테마를 따라서, 너무 투명하면 배경화면에 묻혀 안 보일 수 있어요."
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <!-- 암송 구절 위젯일 때만 보인다 -->
            <LinearLayout
                android:id="@+id/container_group_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="암송 그룹"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown_primary" />

                <RadioGroup
                    android:id="@+id/radio_groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="고른 그룹의 구절이 날마다 하나씩 바뀌어 보여요."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_widget_config_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:padding="14dp"
                android:gravity="center"
                android:text="완료"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_save_button"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>