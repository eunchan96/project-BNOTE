<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_book_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/text_current_book"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="창세기"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_book_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/btn_by_book_sort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="15dp"
                android:gravity="end|center_vertical"
                android:textSize="13sp"
                android:textColor="@color/brown_primary"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                tools:text="날짜순 ▾" />
        </LinearLayout>

        <com.chan.bnote.ui.common.HorizontalSwipeInterceptLayout
            android:id="@+id/swipe_intercept_chapter_grid"
            android:layout_width="match_parent"
            android:layout_height="317dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chapter_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp" />
        </com.chan.bnote.ui.common.HorizontalSwipeInterceptLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_light" />

        <TextView
            android:id="@+id/text_empty_by_chapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="등록된 설교가 없어요"
            android:textColor="@color/text_hint" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_sermons_by_chapter"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>