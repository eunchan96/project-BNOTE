<?xml version="1.0" encoding="utf-8"?><!-- 암송 구절 위젯. widget_today_verse와 같은 id(widget_root/bg/icon/text/label/message)를 갖고 있어서
     WidgetViews의 공통 함수를 그대로 쓴다. 맨 위 줄은 책 아이콘·구절 위치와 오른쪽 끝 "다음"(›) 버튼, 그 아래 바로 본문. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경 그림. 글자는 그대로 두고 배경만 투명하게 만들 수 있도록 별도 이미지뷰로 둔다. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_widget_light" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_book_open"
                app:tint="@color/widget_light_accent" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_light_accent" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="다음 구절"
                android:background="@drawable/bg_widget_pill_light" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:fontFamily="serif"
            android:text="불러오는 중이에요"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="12"
            android:ellipsize="end"
            android:textColor="@color/widget_light_text_primary" />

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:textSize="13sp"
            android:textColor="@color/widget_light_text_secondary" />

    </LinearLayout>

</FrameLayout>