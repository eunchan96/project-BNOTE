<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <!-- 평소엔 체크 아이콘, "순서 변경" 중엔 같은 자리에 ≡ 손잡이로 바뀐다(잡고 끌어서 순서 변경).
     손잡이를 잡기 쉽게 터치 영역은 26dp로 두고 안쪽 여백 4dp로 아이콘 크기(18dp)와 글자 시작 위치는 예전 그대로 맞춘다. -->
    <ImageView
        android:id="@+id/icon_gratitude_entry"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="4dp"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="4dp"
        android:layout_gravity="top"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/brown_text"
        android:contentDescription="@null" />

    <EditText
        android:id="@+id/edit_gratitude_entry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="감사한 일을 적어보세요"
        android:textSize="15sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@null"
        android:inputType="textMultiLine"
        android:imeOptions="actionNext" />
</LinearLayout>