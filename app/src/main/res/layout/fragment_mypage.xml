<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 내 정보 썸네일 -->
    <LinearLayout
        android:id="@+id/container_profile_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_profile_photo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="@color/input_background"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.BNOTE.Circle"
            android:src="@drawable/ic_person" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="홍길동" />

            <TextView
                android:id="@+id/text_profile_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                tools:text="꿈꾸는좋은교회 · 1남선교회 · 집사" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_hint"
            android:contentDescription="내 정보 보기" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 최근 활동 -->
            <LinearLayout
                android:id="@+id/container_recent_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="최근 활동"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/container_recent_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_light" />
            </LinearLayout>

            <!-- 성경읽기표 · 약속의 말씀 · 기도제목 · 암송 구절 · 감사 노트: 한 줄에 3칸씩, 아이콘 + 이름 카드. 칸 폭을 항상 같게 하려고 마지막 줄의 빈 칸은 빈 View로 채운다. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:orientation="horizontal">

                <com.chan.bnote.ui.common.SquareLinearLayout
                    android:id="@+id/menu_reading_plan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_reading_plan"
                        app:tint="@color/brown_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="성경읽기표"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:maxLines="2" />
                </com.chan.bnote.ui.common.SquareLinearLayout>

                <com.chan.bnote.ui.common.SquareLinearLayout
                    android:id="@+id/menu_verse_of_year"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_promise"
                        app:tint="@color/brown_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="약속의 말씀"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:maxLines="2" />
                </com.chan.bnote.ui.common.SquareLinearLayout>

                <com.chan.bnote.ui.common.SquareLinearLayout
                    android:id="@+id/menu_prayer_request"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_prayer"
                        app:tint="@color/brown_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="기도제목"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:maxLines="2" />
                </com.chan.bnote.ui.common.SquareLinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:orientation="horizontal">

                <com.chan.bnote.ui.common.SquareLinearLayout
                    android:id="@+id/menu_memorization"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="@color/brown_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="암송 구절"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:maxLines="2" />
                </com.chan.bnote.ui.common.SquareLinearLayout>

                <com.chan.bnote.ui.common.SquareLinearLayout
                    android:id="@+id/menu_gratitude"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_book_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/brown_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="감사 노트"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:maxLines="2" />
                </com.chan.bnote.ui.common.SquareLinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>