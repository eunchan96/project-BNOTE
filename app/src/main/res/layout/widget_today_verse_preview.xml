<?xml version="1.0" encoding="utf-8"?><!-- 위젯 추가 화면(위젯 목록)에서 보여줄 "오늘의 말씀" 미리보기(안드로이드 12 이상). 실제 위젯과 같은
     모양에 예시 구절을 넣어둔 것으로, 실제 위젯 레이아웃(widget_today_verse)을 바꾸면 여기도 맞춰준다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_widget_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 말씀"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_light_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="시편 23편 1절"
                android:textSize="12sp"
                android:textColor="@color/widget_light_text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="여호와는 나의 목자시니 내가 부족함이 없으리로다"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/widget_light_text_primary" />

    </LinearLayout>

</FrameLayout>