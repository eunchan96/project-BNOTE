<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seed_reconciliation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <include layout="@layout/include_activity_top_bar" />

    <TextView
        android:id="@+id/text_reconciliation_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:text="성경 본문이 고쳐지면서, 아래 목록의 단어 메모/하이라이트가 원래 가리키던 단어를 새 본문에서 찾지 못했어요. 직접 확인하시고 필요하면 다시 표시해주세요." />

    <TextView
        android:id="@+id/text_reconciliation_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="확인할 항목이 없어요"
        android:textColor="@color/text_hint"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/container_reconciliation_issues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>