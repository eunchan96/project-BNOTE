<?xml version="1.0" encoding="utf-8"?><!-- 음성 재생 툴바(개인용 숨김 기능). 하단바의 성경 탭 아이콘을 길게 누르면 뜬다.
     절 선택 툴바·하이라이트 툴바와 같은 자리, 같은 모양이며 셋 중 하나만 보인다.
     왼쪽부터 [3초 뒤로][재생/일시정지][3초 앞으로] | 재생바 | 배속. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container_audio_toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="24dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="4dp"
    android:visibility="gone"
    android:elevation="8dp"
    android:background="@drawable/bg_selection_toolbar">

    <ImageView
        android:id="@+id/btn_audio_rewind"
        android:layout_width="32dp"
        android:layout_height="44dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:src="@drawable/ic_fast_rewind"
        android:contentDescription="3초 뒤로"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/btn_audio_play_pause"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:src="@drawable/ic_play"
        android:contentDescription="음성 재생"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/btn_audio_forward"
        android:layout_width="32dp"
        android:layout_height="44dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:src="@drawable/ic_fast_forward"
        android:contentDescription="3초 앞으로"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:background="#555555" />

    <SeekBar
        android:id="@+id/seek_audio_position"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:progressTint="@color/brown_light"
        android:thumbTint="@color/brown_light"
        android:progressBackgroundTint="#888888" />

    <View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:background="#555555" />

    <TextView
        android:id="@+id/btn_audio_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp"
        android:padding="12dp"
        android:gravity="center"
        android:text="1.0x"
        android:textSize="14sp"
        android:maxLines="1"
        android:textColor="@color/white"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>