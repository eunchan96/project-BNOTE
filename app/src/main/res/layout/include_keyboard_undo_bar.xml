<?xml version="1.0" encoding="utf-8"?><!-- 키보드가 올라와 있을 때만 키보드 바로 위에 보이는 "실행 취소 / 다시 실행" 바.
     화면 루트의 맨 아래에 두면, 루트가 키보드 높이만큼 하단 패딩을 주고 있어서 자연스럽게 키보드 위에 붙는다.
     보이기/숨기기는 KeyboardUndoBar가 키보드 표시 여부를 보고 처리한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_undo_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_elevated"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/btn_keyboard_undo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="실행 취소">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_secondary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="실행 취소"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_keyboard_redo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="다시 실행">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_secondary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="다시 실행"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>