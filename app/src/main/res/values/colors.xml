<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="brown_primary">#795548</color>
    <!-- 절 선택(드래그/롱프레스) 중일 때 선택 구간에 직접 씌우는 회색 배경. 안드로이드가 자체적으로
         그리는 선택 배경은 우리가 이미 칠해둔 하이라이트 배경보다 먼저 그려지는 구조라 하이라이트에
         가려 안 보였는데, 이건 하이라이트와 똑같이 스패너블에 직접 얹는 배경 스팬이라 그 위에 그려진다. -->
    <color name="verse_selection_background">#B0B0B0</color>
    <color name="verse_scrollbar_thumb">#B3707070</color>
    <color name="brown_primary_dark">#5D4037</color>
    <color name="brown_light">#A1887F</color>

    <color name="bottom_nav_selected">#795548</color>
    <color name="bottom_nav_unselected">#9E9E9E</color>
    <color name="divider_light">#E0E0E0</color>
    <color name="verse_selected_bg">#E0E0E0</color>

    <!-- 다크모드 대응 시맨틱 색상 (라이트 기본값) -->
    <color name="surface_background">#FFFFFF</color>
    <color name="surface_elevated">#FFFFFF</color>
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#757575</color>
    <color name="text_hint">#9E9E9E</color>
    <!-- 카테고리 미지정 설교의 기본 색상 (라이트 모드에서도 잘 보이도록) -->
    <color name="category_none">#D6D6D6</color>
    <color name="input_background">#F5F5F5</color>
    <color name="highlight_yellow">#FFF9C4</color>

    <!-- 마이페이지 성경 읽기 진행률 그리드 -->
    <color name="book_progress_none_bg">#F5F5F5</color>
    <color name="book_progress_partial_bg">#D7CCC8</color>
    <color name="book_progress_none_text">#333333</color>

    <!-- 리스트 액션 아이콘(삭제 등) 톤 - 다크모드에서 흰색으로 전환 -->
    <color name="icon_action_tint">#795548</color>

    <!-- 다이얼로그(카테고리/설교자 추가 등) 배경 - 갈색 베이스 -->
    <color name="dialog_background">#F7EFEA</color>
    <color name="dialog_title_text">#5D4037</color>

    <!-- 화면 바탕(흰색/검정) 위에 쓰는 갈색 글자·아이콘. 배경용 brown_primary와 나눠둔 이유: 다크모드에서
     brown_primary(#795548)를 글자색으로 쓰면 검은 바탕에서 거의 안 보여서, 다크모드에서만 밝은 갈색으로
     바꾼다(values-night). 상단바처럼 갈색 "배경"에는 계속 brown_primary를 쓴다. -->
    <color name="brown_text">#795548</color>
    <!-- 박스형 버튼(bg_book_button 등)을 눌렀을 때 퍼지는 물결 색 -->
    <color name="ripple_brown">#D7CCC8</color>
    <!-- 화면 위에 떠 있는 둥근 툴바(절 선택·하이라이트·음성 재생)의 배경 -->
    <color name="floating_toolbar_background">#333333</color>

    <!-- bg_field_underline 에서 사용되는 색상. 다크모드에서 흰색으로 전환 -->
    <color name="field_underline">#757575</color>

    <!-- 알림(공지사항): 안 읽은 알림 빨간 점, 안 읽은 항목 배경 -->
    <color name="notice_dot">#E53935</color>
    <color name="notice_unread_background">#FBF6F2</color>

    <!-- 알림 종류 표시(파스텔): 배경 / 글자 -->
    <color name="notice_type_update_bg">#EFE7E1</color>
    <color name="notice_type_update_text">#6D4C41</color>
    <color name="notice_type_bible_bg">#F8E1E1</color>
    <color name="notice_type_bible_text">#B5524F</color>
    <color name="notice_type_bug_bg">#FBEBD9</color>
    <color name="notice_type_bug_text">#B26A2E</color>
    <color name="notice_type_tip_bg">#E3F0E3</color>
    <color name="notice_type_tip_text">#4E7D52</color>
    <color name="notice_type_general_bg">#E6EBEF</color>
    <color name="notice_type_general_text">#57656F</color>
</resources>