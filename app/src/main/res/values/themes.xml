<resources>

    <style name="Base.Theme.BNOTE" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brown_primary</item>
        <item name="colorPrimaryDark">@color/brown_primary_dark</item>
        <item name="android:statusBarColor">@color/brown_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/surface_background</item>
    </style>

    <style name="Theme.BNOTE" parent="Base.Theme.BNOTE" />

    <!-- 시작화면(스플래시): 브라운 배경 + 책 아이콘, 뜬 뒤 바로 본 테마로 전환 -->
    <style name="Theme.BNOTE.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brown_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_bible_only</item>
        <item name="postSplashScreenTheme">@style/Theme.BNOTE</item>
    </style>

    <style name="RightPanelDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/RightPanelAnimation</item>
    </style>

    <style name="RightPanelAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="QuoteBubbleDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- 카테고리/설교자/그룹 추가·수정 등에 쓰는 입력 다이얼로그 공용 스타일.
         배경을 원래 크림색(dialog_background)에서 흰색(surface_elevated)으로 바꿨다 —
         bottom sheet들과 같은 배경이어야 그 안의 테두리 입력칸(bg_memo_box_outline 등)이
         실제로 잘 구분돼 보이고, 앱 전체적으로도 느낌이 통일된다.
         + 모서리를 M3 기본값(28dp, 꽤 둥글둥글함)보다 절제된 크기로, 확인 버튼은 기본 텍스트
         버튼 대신 bottom sheet 저장 버튼과 같은 갈색 채움 버튼으로 바꿨다. -->
    <style name="ThemeOverlay.BNOTE.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="materialAlertDialogTitleTextStyle">@style/BNOTE.Dialog.TitleText</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BNOTE.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/BNOTE.Dialog.Button.Positive</item>
    </style>

    <style name="ShapeAppearance.BNOTE.Dialog" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- bottom sheet들의 "저장" 버튼(갈색 배경 + 흰 글씨)과 같은 느낌으로 맞춘, 다이얼로그의
         확인/추가/저장 버튼. Widget.Material3.Button 기본값은 터치 영역 확보용 inset과 최소
         크기가 있어서 옆의 "취소" 텍스트 버튼과 크기·위치가 안 맞고 붕 떠 보였다 — 그 여백들을
         없애고 패딩을 직접 줘서 버튼 바 안에 자연스럽게 앉도록 조정했다. -->
    <style name="BNOTE.Dialog.Button.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brown_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="BNOTE.Dialog.TitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dialog_title_text</item>
    </style>

    <!-- 내 정보 프로필 사진을 원형으로 잘라주는 shapeAppearanceOverlay -->
    <style name="ShapeAppearance.BNOTE.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>