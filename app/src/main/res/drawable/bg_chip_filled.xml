<?xml version="1.0" encoding="utf-8"?>
<!-- bg_chip_outline의 "선택됨" 버전(알림 목록의 필터 칩 등) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_brown">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brown_text" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/brown_text" />
        </shape>
    </item>
</ripple>