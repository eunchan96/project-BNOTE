<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 찬송 화면의 유튜브 재생/썸네일 로딩에 필요 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 매일 말씀 알림 · 통독 리마인더를 정확한 시각에 보내기 위한 정확 알람 권한.
         Android 12+에서는 사용자가 설정 화면에서 직접 허용해야 한다(SettingsActivity 참고). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 재부팅 시 정확 알람(위 알림들)을 다시 예약하기 위해 필요 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 성경 탭 메뉴의 "방해금지 모드 활성화" 토글용. 이것만으로 실제 방해금지를 켤 순 없고,
         NotificationManager.isNotificationPolicyAccessGranted()가 true여야(사용자가 설정
         화면에서 직접 허용해야) 실제로 켤 수 있다. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 설교 사진 첨부(카메라 촬영)에 필요 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- android:configChanges 메모: 블루투스·물리 키보드가 연결되거나 끊기면(keyboard·keyboardHidden·navigation) 안드로이드는 기본적으로 화면(Activity)을 통째로 다시 만든다.
         글을 쓰는 화면에서 이게 일어나면 아직 저장 안 된 입력·선택값이 날아갔다(설교 노트 작성 중 키보드가 끊기면 초기화되던 원인).
         그래서 글을 쓰는 화면들은 이런 변화에도 다시 만들지 않고 그대로 두도록 지정한다. 작성 화면들은 화면 회전·창 크기 변경(분할 화면 등)도 같은 이유로 포함한다
         — 가로 전용 레이아웃(layout-land 등)이 없어서, 다시 만들지 않고 그대로 다시 배치만 해도 똑같이 보인다. MainActivity·기도제목은 글쓰기 창이 바텀시트라 키보드 관련 변화만 넣었다. -->
